# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=     # Any string you choose for webhook subscription
STRAVA_WEBHOOK_SECRET=           # Returned by Strava when you register the webhook

# Anthropic
ANTHROPIC_API_KEY=

# Resend
RESEND_API_KEY=

# App
NEXT_PUBLIC_APP_URL=             # e.g. https://pacepact.com or http://localhost:3000
NEXT_PUBLIC_SIGNUP_ENABLED=true  # Set to 'false' to disable public signup (invite-only mode)
