# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=     # Any string you choose for webhook subscription

# Anthropic
ANTHROPIC_API_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_DOMAIN=                # Verified domain in Resend, e.g. pacepact.com (used as noreply@<domain>)

# Stripe
STRIPE_SECRET_KEY=               # sk_test_... (test) or sk_live_... (production)
STRIPE_WEBHOOK_SECRET=           # whsec_... — from Stripe CLI (local) or Stripe Dashboard (production)

# App
NEXT_PUBLIC_APP_URL=             # e.g. https://pacepact.com or http://localhost:3000
NEXT_PUBLIC_SIGNUP_ENABLED=true  # Set to 'false' to disable public signup (invite-only mode)
NEXT_PUBLIC_PAYMENTS_ENABLED=false  # Set to 'true' to enable Stripe payment step (see docs/stripe-setup.md)
